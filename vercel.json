{
  "version": 2,
  "builds": [
    {
      "src": "state.js",
      "use": "@vercel/node"
    },
    {
      "src": "login.js",
      "use": "@vercel/node"
    },
    {
      "src": "reset.js",
      "use": "@vercel/node"
    },
    {
      "src": "**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/state",
      "dest": "/state.js"
    },
    {
      "src": "/api/login",
      "dest": "/login.js"
    },
    {
      "src": "/api/reset",
      "dest": "/reset.js"
    },
    {
      "handle": "filesystem"
    }
  ]
}
